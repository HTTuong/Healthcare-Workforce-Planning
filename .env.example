# Read by docker-compose.yml for the whole stack (`docker compose --profile app up`). Copy to .env and fill in.
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
# The first admin, created with `docker compose run --rm backend npm run create-admin`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
