# Copy to .env and adjust. The tests read it at start-up; real environment variables win.
API_URL=http://localhost:3000
UI_URL=http://localhost:5173
# The admin created with `npm run create-admin` in apps/backend. The tests use it to create their own users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-the-admin-password
# Password the tests give to the users they create (12 to 128 characters).
E2E_PASSWORD=E2e-Password-123!
